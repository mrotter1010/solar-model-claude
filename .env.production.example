# =============================================================================
# Solar Model Platform — Production Environment Variables
# =============================================================================
# Copy to .env.production and fill in real values before deploying.
# NEVER commit .env.production — only this .example file is checked in.
#
# Local dev:   docker compose -f docker-compose.yml -f docker-compose.dev.yml up
# Production:  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ---------------------------------------------------------------------------
# CORS — allowed frontend origins (comma-separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://app.vantyraanalytics.com

# ---------------------------------------------------------------------------
# Analysis API (backend)
# ---------------------------------------------------------------------------
# Internal Docker network URL used by the orchestrator to reach the API
ANALYSIS_API_URL=http://api:8000

# API key for authenticated access to the analysis API
API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# NSRDB (weather data)
# ---------------------------------------------------------------------------
NSRDB_API_KEY=your-key-here
NSRDB_API_EMAIL=your-email-here

# ---------------------------------------------------------------------------
# Orchestrator (LLM service)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Database (TimescaleDB)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://solar:changeme@timescaledb:5432/solar_model
POSTGRES_USER=solar
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Access control — ORCHESTRATOR ONLY (do NOT set on the API service)
# ---------------------------------------------------------------------------
# Comma-separated invite codes for the beta access gate. The frontend sends
# X-Invite-Code on every orchestrator request. The API service must NOT use
# this — it relies on API_KEY for auth, and browser-initiated requests
# (image loads, PDF/CSV download links) cannot send custom headers.
INVITE_CODES=code1,code2,code3

# ---------------------------------------------------------------------------
# Frontend (Vite build-time variables — must be prefixed with VITE_)
# ---------------------------------------------------------------------------
# Relative paths — resolved by Nginx reverse proxy in production
VITE_ANALYSIS_API_URL=/api
VITE_ORCHESTRATOR_URL=/orchestrator
VITE_ANALYSIS_API_KEY=your-api-key-here
