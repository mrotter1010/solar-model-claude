# Solar Model API — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# API authentication key (optional — auth is disabled if unset/empty)
API_KEY=

# PostgreSQL connection URL (default matches docker-compose.yml)
DATABASE_URL=postgresql://solar:solar@timescaledb:5432/solar_model

# NREL NSRDB credentials (required for climate data fetching)
# Register at https://developer.nrel.gov/signup/
NSRDB_API_KEY=
NSRDB_API_EMAIL=

# Upload directory (default: uploads)
UPLOAD_DIR=uploads
