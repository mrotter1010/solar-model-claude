# Solar Model API — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# API authentication key (optional — auth is disabled if unset/empty)
API_KEY=

# PostgreSQL connection URL (default matches docker-compose.yml)
DATABASE_URL=postgresql://solar:solar@timescaledb:5432/solar_model

# NREL NSRDB credentials (required for climate data fetching)
# Register at https://developer.nlr.gov/signup/
NSRDB_API_KEY=
NSRDB_API_EMAIL=

# Upload directory (default: uploads)
UPLOAD_DIR=uploads

# --- Orchestrator (LLM service on port 8001) ---

# OpenAI API key (required for the orchestrator)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model (optional — defaults to gpt-5)
OPENAI_MODEL=gpt-5
